{
  "manifest_version": 3,
  "name": "YT2PR – Téléchargeur vidéo",
  "version": "1.0.0",
  "description": "Télécharge les vidéos YouTube, X/Twitter, Instagram, TikTok en qualité maximale, avec choix du timecode.",
  "key": "",
  "permissions": ["nativeMessaging", "activeTab", "storage"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "YT2PR", "default_popup": "popup.html" }
}
